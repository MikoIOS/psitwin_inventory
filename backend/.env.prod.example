# --- Backend (FastAPI) ---
# Copiar a backend/.env.prod; Compose inyecta estas variables
APP_NAME=PsiTwin Inventory API
APP_VERSION=1.0.0

MONGODB_URL=mongodb://mongo:27017
MONGODB_DATABASE=psitwin_inventory

SECRET_KEY=GENERA_UNA_CLAVE_LARGA_Y_ALEATORIA
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
EMAIL_VERIFICATION_TTL_MINUTES=10
EMAIL_VERIFICATION_COOLDOWN_SECONDS=60
EMAIL_VERIFICATION_MAX_ATTEMPTS=5
FRONTEND_URL=http://tudominio.com

CORS_ORIGINS=http://tudominio.com

OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_CONNECT_TIMEOUT_SECONDS=5
OLLAMA_READ_TIMEOUT_SECONDS=300

# Sensores (broker Mosquitto: backend/infra/mosquitto)
MQTT_ENABLED=true
MQTT_HOST=mosquitto
MQTT_PORT=1883
MQTT_USER=psitwin-backend
MQTT_PASSWORD=GENERA_UNA_CLAVE_MQTT
