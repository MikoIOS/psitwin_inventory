# --- Frontend (Vite) ---
# Copiar a frontend/.env  (Vite carga .env desde su cwd)
#
# Desarrollo: el frontend llama a /api/v1 y Vite lo reenvía a este backend (sin problemas de CORS).
VITE_PROXY_TARGET=http://localhost:8000

# Solo si quieres llamar al backend directamente (requiere CORS habilitado en el backend).
# Incluye /api/v1, sin barra final.
# VITE_API_URL=http://localhost:8000/api/v1

# Vercel: usar /api/v1 para pasar por el proxy de vercel.json hacia Render.
# Configurar en Production y Preview; reconstruir el deployment tras cambiarla.
# VITE_API_URL=/api/v1
